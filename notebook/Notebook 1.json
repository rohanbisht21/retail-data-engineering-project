			{
				"cell_type": "code",
				"source": [
					"# Retail Data Engineering Project\n",
					"from pyspark.sql.functions import col, to_date, lower\n",
					"df_bronze = spark.read.parquet(\"abfss://retial@retailrb.dfs.core.windows.net/Bronze/manish040596/azure-data-engineer-projects/refs/heads/main/retail_transactions_bronze.parquet\")\n",
					"df_bronze.show()"
				],
				"execution_count": 1
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					""
				]
			},
			{
				"cell_type": "code",
				"source": [
					"\n",
					"df_silver = (\n",
					"    df_bronze\n",
					"    .filter(col(\"event_type\")==\"purchase\")\n",
					"    .dropna(subset=[\"customer_id\",\"amount\"])\n",
					"    .withColumn(\"event_date\",to_date(col(\"event_timestamp\")))\n",
					"    .withColumn(\"payment_method\",lower(col(\"payment_method\")))\n",
					"    .withColumn(\"amount\",col(\"amount\").cast(\"float\"))\n",
					"\n",
					"    .select(\"event_id\",\"customer_id\",\"event_date\",\n",
					"    \"product_id\",\"product_category\",\"payment_method\",\"amount\",\"location\")\n",
					"\n",
					")\n",
					"\n",
					"df_silver.write.mode(\"overwrite\").parquet(\"abfss://retial@retailrb.dfs.core.windows.net/Silver\")\n",
					""
				],
				"execution_count": null
			},
			{
				"cell_type": "code",
				"source": [
					"df_silver.show()"
				],
				"execution_count": 12
			},
			{
				"cell_type": "code",
				"source": [
					"# Gold Layer - Aggregates\n",
					"from pyspark.sql.functions import sum, count, col\n",
					"\n",
					"df_silver = spark.read.parquet(\"abfss://retial@retailrb.dfs.core.windows.net/Silver/\")\n",
					"\n",
					"df_silver.show()\n",
					"\n",
					"df_daily_revenue = (\n",
					"    df_silver.groupBy(\"event_date\")\n",
					"    .agg(sum(\"amount\").alias(\"daily_revenue\"), count(\"*\").alias(\"total_purchases\"))\n",
					")\n",
					"\n",
					"df_daily_revenue.write.mode(\"overwrite\").parquet(\"abfss://retial@retailrb.dfs.core.windows.net/Gold/\")"
				],
				"execution_count": 14
			}
		]
